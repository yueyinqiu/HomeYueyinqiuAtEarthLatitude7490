#!/usr/bin/env bash

# "$MMMM" for the MihomoManager.MihomoMixin binary
# "$OUTPUT_PATH" for writing the final merged configuration
# "$TEMP_DIRECTORY" for temporary files (cleaned up after the service stops)
# "$STATE_DIRECTORY" for persistent files (retained across runs)
# "$HOME_MANAGER_MIHOMO_MANAGER_PROXIES" for the generated list of managed proxy instances
# . for the instance's own configuration files

cat > "$OUTPUT_PATH" << EOF
mode: global

proxy-groups:
  - name: GLOBAL
    type: select
    proxies:
      - tongji-proxy
      - DIRECT

proxies:
  - name: tongji-proxy-easytier-socks
    type: socks5
    server: 127.0.0.1
    port: 56509
  - name: tongji-proxy
    type: vless
    server: 10.236.127.1
    port: 46987
    uuid: "<在 https://tongji-proxy-credential.tjslp.yueyinqiu.top/ 创建的凭证>"
    network: tcp
    udp: true
    tls: true
    servername: www.bilibili.com
    reality-opts:
      public-key: tV3aWRpfav9CgoyrTk1KGK9RGJGcgN37gSDJDK-NDHg
      short-id: 20b2a7cae3d8fde7
      support-x25519mlkem768: true
    client-fingerprint: chrome
    dialer-proxy: tongji-proxy-easytier-socks
EOF
